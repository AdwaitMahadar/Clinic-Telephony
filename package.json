    "axios": "^1.6.0",
    "date-fns-tz": "^2.0.0",
    "zod": "^3.22.0",
    "nanoid": "^5.0.0",
    "pino": "^8.16.0",
    "pino-pretty": "^10.2.0"
  },
  "devDependencies": {
    "typescript": "^5.3.0",
    "tsx": "^4.7.0",
    "@types/node": "^20.10.0",
    "@types/ws": "^8.5.0",
    "vitest": "^1.0.0"
